{
  "name": "competition-tracker",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "start": "node server.mjs",
    "check": "astro check",
    "test": "node --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/seed.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "format": "prettier --write src scripts test *.mjs *.ts package.json",
    "format:check": "prettier --check src scripts test *.mjs *.ts package.json"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@tailwindcss/vite": "^4.1.0",
    "alpinejs": "^3.14.0",
    "astro": "^7.3.3",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.63.0",
    "@types/alpinejs": "^3.13.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
