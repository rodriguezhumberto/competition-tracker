# Generate a private passcode (e.g. node -p "require('node:crypto').randomBytes(32).toString('hex')").
ADMIN_PASSCODE=
HOST=0.0.0.0
PORT=4321
# Build-time trusted HTTPS hostname and demo invitation domain. Empty for localhost.
# Rebuild the app/image after changing it.
PRODUCTION_HOSTNAME=
DATABASE_PATH=./sqlite.db
DEMO_DIR=./data/demos
# Public and presenter demos are available at /demo. Set false to disable demos and admin launch.
DEMO_ENABLED=true
UPLOAD_DIR=./data/proofs
# Operator details displayed on the public privacy policy.
SITE_OPERATOR_NAME=Site operator
PRIVACY_CONTACT_EMAIL=
# An OpenAI-compatible /v1 base URL, or a full /chat/completions endpoint.
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
VISION_API_KEY=
# For Ollama: VISION_BASE_URL=http://localhost:11434/v1
# Set VISION_MODEL to the exact installed vision-capable model; leave key empty.

# Optional exact trusted proxy peer IPs for WebSocket visitor quotas.
# Leave empty unless you control those peers and their forwarding headers.
TRUSTED_PROXY_IPS=

# Local text-orientation detection (Tesseract 5 with osd.traineddata).
# Defaults to tesseract on PATH. Manual rotation remains available if missing.
TESSERACT_PATH=tesseract
