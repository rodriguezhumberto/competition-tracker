---
import { formatMetric } from '../lib/metrics.ts';
import type { leaderboard } from '../lib/competition-store.ts';
interface Props {
  board: ReturnType<typeof leaderboard>;
}
const { board } = Astro.props;
const rows = board.rows.filter((row) => row.rank !== null);
const metric = board.selected;
const peak = Math.max(0, ...rows.map((row) => Number(row.values[metric.key] || 0)));
---

<div
  class="vertical-content"
  x-data={`{
  capacity: 0, observer: null,
  init() {
    this.observer = new ResizeObserver(([entry]) => {
      const styles = getComputedStyle(this.$refs.chart);
      const width = parseFloat(styles.getPropertyValue('--column-width'));
      const gap = parseFloat(styles.columnGap);
      this.capacity = Math.max(0, Math.floor((entry.contentRect.width + gap) / (width + gap)));
    });
    this.observer.observe(this.$refs.chart);
  },
  destroy() { this.observer?.disconnect(); }
}`}
>
  <div
    class="vertical-chart"
    x-ref="chart"
    role="list"
    aria-label={`Top participants by ${metric.label}`}
  >
    {rows.map((row, index) => (
      <div class="vertical-column" role="listitem" x-cloak x-show={`${index} < capacity`}>
        <div class="vertical-track">
          <div
            class:list={['vertical-bar', { 'vertical-leading': row.rank === 1 }]}
            style={`height:${peak > 0 ? Math.max(0, Math.min(100, (Number(row.values[metric.key]) / peak) * 100)) : 0}%`}
          >
            <div class="vertical-bar-label">
              <strong
                class="vertical-sales"
                title={`${formatMetric(row.values[metric.key], metric)} ${metric.label}`}
              >
                {formatMetric(row.values[metric.key], metric)}
                <span class="sr-only"> {metric.label}</span>
              </strong>
              {row.rank !== null && row.rank <= 3 && (
                <svg
                  class:list={['rank-trophy', `rank-trophy-${row.rank}`]}
                  viewBox="0 0 24 24"
                  role="img"
                  aria-label={`Rank ${row.rank}`}
                >
                  <path
                    d="M5 4H2c0 3.7 1.4 6 5.3 7.1M19 4h3c0 3.7-1.4 6-5.3 7.1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                  />
                  <path d="M6 2h12v2h4c0 4.1-2 6.7-5.2 7.6-.8 1.8-2.1 3.1-3.8 3.8V19h3.3c.9 0 1.7.8 1.7 1.7v.6c0 .9-.8 1.7-1.7 1.7H7.7c-.9 0-1.7-.8-1.7-1.7v-.6c0-.9.8-1.7 1.7-1.7H11v-3.6c-1.7-.7-3-2-3.8-3.8C4 10.7 2 8.1 2 4h4V2Z" />
                </svg>
              )}
            </div>
          </div>
        </div>
        <strong class="vertical-operator">#{row.operatorNumber}</strong>
        <span class="vertical-rank">Rank {row.rank}</span>
      </div>
    ))}
  </div>
  <slot />
</div>
<style>
  .vertical-content {
    padding: 0 24px 24px;
  }
  .vertical-chart {
    --column-width: 88px;
    display: flex;
    gap: 16px;
    align-items: flex-end;
  }
  .vertical-column {
    flex: 1 1 var(--column-width);
    min-width: var(--column-width);
    max-width: 140px;
    text-align: center;
    padding-top: 72px;
  }
  .vertical-track {
    height: 220px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    box-shadow: 0 1px #cbd9e5;
  }
  .vertical-bar {
    position: relative;
    width: 64%;
    background: #9ab9d3;
    border-radius: 5px 5px 0 0;
  }
  .vertical-leading {
    background: #1a5993;
  }
  .vertical-bar-label {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-bottom: 9px;
    width: var(--column-width);
  }
  .vertical-sales {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .vertical-bar-label .rank-trophy {
    width: 18px;
    height: 18px;
    margin: 0;
  }
  .vertical-operator {
    display: block;
    margin-top: 12px;
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .vertical-rank {
    display: block;
    margin-top: 4px;
    color: #60788c;
    font-size: 10px;
  }
  :global(:root[data-theme='dark']) .vertical-track {
    box-shadow: 0 1px #29445d;
  }
  :global(:root[data-theme='dark']) .vertical-rank {
    color: #b8c7d5;
  }
  @media (max-width: 640px) {
    .vertical-content {
      padding: 0 16px 24px;
    }
  }
</style>
