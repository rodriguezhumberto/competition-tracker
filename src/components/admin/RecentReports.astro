---
import Icon from '../Icon.astro';
import type { recentMetricReports } from '../../lib/competition-store.ts';
import { formatMetric } from '../../lib/metrics.ts';
import { centralReportTime } from '../../lib/central-time.ts';
interface Props {
  recent: ReturnType<typeof recentMetricReports>;
}
const { recent } = Astro.props;
const hasItems = recent.some((entry) => entry.itemCode);
---

<section class="panel full-panel">
  <h2>Recent reports</h2>
  <p>Reported values and their contributions. Latest-value metrics replace the score.</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>PARTICIPANT</th>
          <th>COMPETITION</th>
          {hasItems && <th>ITEM</th>}
          <th>REPORT TIME (CENTRAL)</th>
          <th>METRICS</th>
          <th>PROOF</th>
        </tr>
      </thead>
      <tbody>
        {recent.map((e) => (
          <tr>
            <td>#{e.operatorNumber}</td>
            <td>{e.competition}</td>
            {hasItems && (
              <td>
                {e.itemCode ? (
                  <div class="recent-metric">
                    <strong>{e.itemName}</strong>
                    <small>{e.itemCode}</small>
                  </div>
                ) : (
                  '—'
                )}
              </td>
            )}
            <td>{centralReportTime(e.date)}</td>
            <td>
              {e.values.map((v) => (
                <div class="recent-metric">
                  <strong>
                    {v.label}: {formatMetric(v.value, v)}
                  </strong>
                  <small>
                    {v.contribution === null
                      ? 'Latest value'
                      : `Contribution: ${formatMetric(v.contribution, v)}`}
                  </small>
                </div>
              ))}
            </td>
            <td>
              {e.proof ? (
                <a href={`/api/proof?id=${e.id}`} target="_blank" rel="noreferrer">
                  View <Icon />
                </a>
              ) : (
                'Manual'
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {!recent.length && <p class="empty-state">No reports submitted yet.</p>}
</section>
