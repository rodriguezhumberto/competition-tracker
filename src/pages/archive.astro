---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { expireSessions, getArchives, sessionScores } from '../lib/store.ts';
expireSessions();
const sessions = getArchives();
---

<Layout title="Power Hour archive" active="archive">
  <div class="page-heading">
    <div>
      <h1>Power Hour archive</h1>
      <p>Past Power Hour results. Scores are tracked separately from the main leaderboard.</p>
    </div>
  </div>
  <div class="archive-grid">
    {sessions.map((s) => (
      <a
        class="panel archive-card competition-card"
        href={`/archive/${s.id}`}
        aria-label={`View ${s.name} full results`}
      >
        <span class="pill">Archived</span>
        <h2>{s.name}</h2>
        <p>
          Tracking {s.metric_label || 'points'} ·{' '}
          {new Date(s.created_at).toLocaleString('en-US', { timeZone: 'UTC' })} UTC
        </p>
        <ol>
          {sessionScores(s.id)
            .slice(0, 5)
            .map((p, i) => (
              <li>
                <span>
                  {String(i + 1).padStart(2, '0')}. {p.name}
                  {p.flagged && <small> · review entry rate</small>}
                </span>
                <strong>
                  {p.clicks} {s.metric_label || 'points'}
                </strong>
              </li>
            ))}
        </ol>
        <span class="competition-card-action">
          View full results <Icon />
        </span>
      </a>
    ))}
  </div>
  {!sessions.length && (
    <div class="panel empty-state">
      No archived Power Hours yet.
      <br />
      <a href="/admin#power-hour">
        Start your first Power Hour <Icon />
      </a>
    </div>
  )}
</Layout>
