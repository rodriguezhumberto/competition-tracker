---
import { itemFilterErrorResponse } from '../lib/leaderboard.ts';
import Layout from '../layouts/Layout.astro';
import PowerHourExperience from '../components/PowerHourExperience.astro';
import { publicSnapshot } from '../lib/store.ts';
import { currentCompetition, leaderboard } from '../lib/competition-store.ts';
import { getSitePrivacy } from '../lib/site-access.ts';
const competition = currentCompetition();
let board;
try {
  board = competition
    ? leaderboard(competition.id, {
        metric: Astro.url.searchParams.get('metric'),
        period: Astro.url.searchParams.get('period'),
        item: Astro.url.searchParams.get('item'),
        activityLimit: 12,
      })
    : null;
} catch (error) {
  const response = itemFilterErrorResponse(error, Astro.url);
  if (response) return response;
  throw error;
}

const initial = {
  ...publicSnapshot(),
  requiresPowerHourPassword: !getSitePrivacy().enabled,
};
---

<Layout>
  <PowerHourExperience board={board} initial={initial} />
</Layout>
